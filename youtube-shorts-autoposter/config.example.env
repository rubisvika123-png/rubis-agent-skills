# Copy this file to config.env and fill in the values.
# config.env is read by all three scripts. Never commit it (it holds secrets).

# --- Google OAuth client (create a "Desktop app" client in Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Groq API key (transcription + title/description). Get it at console.groq.com ---
GROQ_API_KEY=

# --- Drive folder names (create these in the account's Google Drive) ---
# Videos to publish go into YT_FOLDER; after posting they are moved into YT_DONE
# (a subfolder of YT_FOLDER) so nothing is posted twice.
YT_FOLDER=Для Ютуба
YT_DONE=Опубликовано

# --- Publish mode: public | unlisted | private ---
YT_PRIVACY=public
