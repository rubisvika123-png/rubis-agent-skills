# Copy this file to config.env and fill in the values.
# config.env is read by all scripts. Never commit it (it holds secrets).

# --- Google OAuth client (create a "Desktop app" client in Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- The one fixed reply sent to every new comment ---
REPLY_TEXT=Спасибо за комментарий! Ссылка — в шапке профиля 🙌
